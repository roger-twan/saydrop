# Copy to .env and chmod 600 .env. Do not commit .env.
# Generate each independent secret locally with secrets.token_hex(32).
SAYDROP_ENVIRONMENT=development
SAYDROP_PROVIDER_MODE=openrouter
SAYDROP_ALLOW_LOOPBACK_HTTP=true
SAYDROP_TOKEN_PEPPER=
SAYDROP_FINGERPRINT_KEY=
SAYDROP_TOKEN_KEY_VERSION=v1
OPENROUTER_API_KEY=
SAYDROP_METRICS_TOKEN=
SAYDROP_METRICS_RETENTION_DAYS=30

# REQUIRED before any real calls: operator-reviewed integer units and worst-case estimates.
# RAW estimate covers max 120s. POLISH estimate covers STT + up to 16000 chars / 2048 tokens.
# Zero, invalid, missing, or unconfigured budgets refuse new tasks.
SAYDROP_DAILY_BUDGET_UNITS=0
SAYDROP_RAW_ESTIMATE_UNITS=0
SAYDROP_POLISH_ESTIMATE_UNITS=0
SAYDROP_BUDGET_CONFIG_VERSION=unconfigured

SAYDROP_STT_MODEL=elevenlabs/scribe-v2
SAYDROP_POLISH_MODEL=openai/gpt-4.1-mini
SAYDROP_REGISTER_IP_HOUR=5
SAYDROP_REGISTER_GLOBAL_HOUR=100
SAYDROP_INSTALLATION_MINUTE=60
SAYDROP_IP_MINUTE=120
SAYDROP_MAX_ACTIVE_TASKS=4
SAYDROP_MAX_RESULTS=32

# Optional Groq STT: set PROVIDER_MODE=groq and STT_MODEL=whisper-large-v3-turbo.
# Groq mode never invokes OpenRouter polish; light_polish returns marked raw fallback.
GROQ_API_KEY=

# Optional explicit local HTTP proxy for Groq only (no ambient proxy settings).
SAYDROP_GROQ_PROXY_URL=
